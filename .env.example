# Estate Follow — VPS/Docker environment template.
#
# Copy this to a real ".env" file NEXT TO docker-compose.yml on the VPS
# (never commit that real file) and fill in actual values there.
# docker-compose.yml reads it via `env_file: .env` — nothing here is ever
# baked into the image or written into docker-compose.yml itself.

# ---- PocketBase (required) ----------------------------------------------
# Must be EXACTLY 32 characters. Once set for a given pb_data volume, this
# can never change without losing the ability to decrypt that data — pick
# it once, store it safely, and never regenerate it against existing data.
PB_ENCRYPTION_KEY=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# ---- Core app ------------------------------------------------------------
PORT=3001
# Comma-separated allowed origins (e.g. https://estatefollow.com).
CORS_ORIGIN=

# ---- Traefik (compose-only — not read by the app itself) -----------------
# This VPS's Traefik runs with network_mode: host and no separate Docker
# network, so no network name is needed here — only the certresolver name
# your existing Traefik static config already defines (check Traefik's own
# config/labels on this VPS for the exact name; a common default is
# "letsencrypt", but do not assume — a wrong name here just means no cert
# is issued for this router, not a broken deploy).
TRAEFIK_CERT_RESOLVER=letsencrypt

# ---- Email / OTP (Resend) -------------------------------------------------
RESEND_API_KEY=

# ---- reCAPTCHA v3 ----------------------------------------------------------
RECAPTCHA_SECRET_KEY=

# ---- Cloudinary (property images / documents) ------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Push notifications (OneSignal) ----------------------------------------
ONESIGNAL_REST_API_KEY=

# ---- Payments ---------------------------------------------------------------
PAYMENT_GATEWAY_ENCRYPTION_KEY=

# ---- Error monitoring (Sentry) — optional -----------------------------------
SENTRY_DSN=

# ---- Site identity (used by SEO/site-info features) — fill in if used ------
WEBSITE_DOMAIN=
WEBSITE_ID=
WEBSITE_URL=
PROXY_ENTRANCE_ID=

# ---- AI features — only the ones actually enabled need real keys -----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_PLAN_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ADVISOR_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_PLAN_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_PLAN_MODEL=
INTEGRATED_AI_API_KEY=
INTEGRATED_AI_API_URL=

# ---- PocketBase hooks: transactional mailer / WhatsApp — optional ----------
BUILDER_MAILER_API_KEY=
BUILDER_MAILER_API_URL=
BUILDER_MAILER_SENDER_ADDRESS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Internal test-only routes — leave blank in production -----------------
TEST_INSIGHTS_KEY=
TEST_CHAT_KEY=
