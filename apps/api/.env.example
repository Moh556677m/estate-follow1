# API server (apps/api) — required environment variables.
#
# The "dev"/"start" scripts (see package.json) run node with
# --env-file=.env, so copy this file to `.env` in this same folder and
# fill in real values there. Never commit the real `.env` file.

# Port the Express server listens on.
PORT=3001

# Comma-separated list of allowed CORS origins for the API (e.g. your
# Hostinger Horizons site URL). Leave empty only for local development.
CORS_ORIGIN=

# Smart Payment Plan Reader — direct Anthropic Claude API (user-supplied key).
# Add your Anthropic API key here (starts with sk-ant-...). Keep it server-side only.
ANTHROPIC_API_KEY=

# Claude vision model used to read payment-plan documents. Override if needed.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Smart Payment Plan Reader model — defaults to the faster Haiku for speed.
# Switch to claude-sonnet-4-6 for maximum extraction accuracy on complex plans.
ANTHROPIC_PLAN_MODEL=claude-haiku-4-5-20251001

# Resend mail delivery key — server-side only.
RESEND_API_KEY=

# Cloudinary — user-uploaded file storage (title deeds, images, documents).
# Server-side only; never exposed to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google reCAPTCHA v3 — secret key (server-side only, never exposed to client).
# Used to verify tokens from the login / signup / forgot-password forms.
RECAPTCHA_SECRET_KEY=

# Optional — used only by internal test/insight routes if enabled.
TEST_INSIGHTS_KEY=

TEST_CHAT_KEY=

# Only needed if any OpenAI-backed feature is enabled.
OPENAI_API_KEY=
