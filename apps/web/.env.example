# Frontend (apps/web) — build-time environment variables.
#
# These must be set in the SAME environment where `vite build` (or `npm
# run build`) actually runs (e.g. Hostinger's build step), not just at
# server-runtime — Vite bakes them into the static bundle at build time.
# See vite.config.js's `define` block for how these two (and ONLY these
# two) non-secret values are forwarded to the browser as import.meta.env.*.
#
# Only the PUBLISHABLE (anon) key belongs here. NEVER put
# SUPABASE_SECRET_KEY in this file or anywhere under apps/web — that key
# is server-side only (see apps/api/.env.example).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
