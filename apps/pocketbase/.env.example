# PocketBase (apps/pocketbase) — required environment variables.
#
# These are NOT read from a .env file at runtime — the "start" script
# (see package.json) launches the `pocketbase` binary directly with
# --encryptionEnv=PB_ENCRYPTION_KEY, which reads the real OS environment
# variable of that name. Set the three variables below as actual
# Environment Variables in the Hostinger app dashboard (or your host's
# process manager), not as a checked-in .env file.
#
# Required for `pocketbase serve` itself:
PB_ENCRYPTION_KEY=
# Required by pb_migrations/1764579159_create_superuser.js (creates the
# initial PocketBase superuser account) AND by apps/api's
# src/utils/pocketbaseClient.js (the API server authenticates to
# PocketBase as this superuser to serve authenticated requests):
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
